<Window x:Class="Katib3omomy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Katib3omomy.ViewModels"
        xmlns:conv="clr-namespace:Katib3omomy.Core.Converters"
        xmlns:models="clr-namespace:Katib3omomy.Core.Models"
        mc:Ignorable="d"
        Title="&#1603;&#1575;&#1578;&#1576; &#1593;&#1605;&#1608;&#1605;&#1610; &#8212; &#1605;&#1608;&#1604;&#1583; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;&#1575;&#1578; &#1575;&#1604;&#1585;&#1587;&#1605;&#1610;&#1577;"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:InverseNullToVisibilityConverter x:Key="InvNullToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- XXXX LEFT PANEL XXXX -->
        <Grid Grid.Column="0" Background="#FFF5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="24,24,24,12"
                       Text="&#1605;&#1593;&#1575;&#1610;&#1606;&#1577; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;"/>

            <!-- Status Card -->
            <Border Grid.Row="1" Background="{StaticResource CardWhiteBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Margin="24,0,24,24" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <!-- Loading -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsParsingTemplate, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="200" Margin="0,0,0,16"/>
                        <TextBlock FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Text="&#1580;&#1575;&#1585;&#1610; &#1575;&#1604;&#1578;&#1581;&#1605;&#1610;&#1604;..."/>
                    </StackPanel>

                    <!-- Success -->
                    <StackPanel VerticalAlignment="Top"
                                Visibility="{Binding LastGenerated, Converter={StaticResource NullToVis}}">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                    Background="{StaticResource SuccessBgBrush}" Margin="0,0,12,0">
                                <TextBlock FontSize="24" Foreground="{StaticResource SuccessTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="&#10003;"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessTextBrush}"
                                           Text="&#1578;&#1605; &#1573;&#1606;&#1588;&#1575;&#1569; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583; &#1576;&#1606;&#1580;&#1575;&#1581;"/>
                                <TextBlock Text="{Binding LastGenerated.TemplateName}" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#FFF8F9FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,4"
                                           Text="&#1575;&#1587;&#1605; &#1575;&#1604;&#1605;&#1604;&#1601;:"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastGenerated.FileName}" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,4"
                                           Text="&#1578;&#1575;&#1585;&#1610;&#1582; &#1575;&#1604;&#1573;&#1606;&#1588;&#1575;&#1569;:"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastGenerated.GeneratedAt, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,0"
                                           Text="&#1575;&#1604;&#1605;&#1587;&#1575;&#1585;:"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastGenerated.FilePath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <TextBlock FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="&#1604;&#1571;&#1601;&#1590;&#1604; &#1580;&#1608;&#1583;&#1577; &#1591;&#1576;&#1575;&#1593;&#1577;&#1548; &#1575;&#1601;&#1578;&#1581; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583; &#1601;&#1610; Microsoft Word &#1579;&#1605; &#1575;&#1591;&#1576;&#1593;&#1607;."/>
                    </StackPanel>

                    <!-- Empty -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding CanShowEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#FFC0C0C0"
                                   Text="&#128196;"/>
                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"
                                   Text="&#1604;&#1605; &#1610;&#1578;&#1605; &#1573;&#1606;&#1588;&#1575;&#1569; &#1571;&#1610; &#1605;&#1587;&#1578;&#1606;&#1583; &#1576;&#1593;&#1583;"/>
                        <TextBlock FontSize="13" Foreground="#FFB0B0B0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Text="&#1575;&#1582;&#1578;&#1585; &#1602;&#1575;&#1604;&#1576;&#1575;&#1611; &#1605;&#1606; &#1575;&#1604;&#1610;&#1587;&#1575;&#1585; &#1608;&#1575;&#1605;&#1604;&#1571; &#1575;&#1604;&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1579;&#1605; &#1575;&#1590;&#1594;&#1591; &#1573;&#1606;&#1588;&#1575;&#1569; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;"/>
                    </StackPanel>

                    <!-- Preview -->
                    <Grid Visibility="{Binding CanShowPreview, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                <Run Text="&#1606;&#1589; &#1575;&#1604;&#1602;&#1575;&#1604;&#1576; (&#1602;&#1575;&#1576;&#1604; &#1604;&#1604;&#1578;&#1593;&#1583;&#1610;&#1604; &#1575;&#1604;&#1605;&#1572;&#1602;&#1578;): "/>
                                <Run Text="{Binding SelectedTemplate.Name}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Button Grid.Column="1"
                                    Command="{Binding ResetDraftCommand}"
                                    IsEnabled="{Binding IsDraftModified}"
                                    Margin="0,0,8,0" Padding="8,4" MinWidth="0"
                                    ToolTip="&#1573;&#1593;&#1575;&#1583;&#1577; &#1575;&#1604;&#1606;&#1589; &#1575;&#1604;&#1571;&#1589;&#1604;&#1610;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/>
                                </Button.Style>
                                <TextBlock FontSize="16" FontWeight="Bold" Text="&#8635;"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding CopyPreviewCommand}"
                                    Padding="8,4" MinWidth="0"
                                    ToolTip="&#1606;&#1587;&#1582; &#1575;&#1604;&#1606;&#1589;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/>
                                </Button.Style>
                                <TextBlock FontSize="16" Text="&#128203;"/>
                            </Button>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{Binding DraftPreviewText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#FFF8F9FA" BorderBrush="{StaticResource BorderBrush}"
                                 FontFamily="Arial" FontSize="14.5" TextAlignment="Right"
                                 FlowDirection="RightToLeft"
                                 Padding="12" MinHeight="200"/>

                        <TextBlock Grid.Row="2"
                                   FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="&#1605;&#1593;&#1575;&#1610;&#1606;&#1577; &#1601;&#1602;&#1591; &#8226; &#1575;&#1604;&#1578;&#1593;&#1583;&#1610;&#1604;&#1575;&#1578; &#1607;&#1606;&#1575; &#1604;&#1575; &#1578;&#1572;&#1579;&#1585; &#1593;&#1604;&#1609; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583; &#8226; &#1575;&#1604;&#1582;&#1591;Ø&#1404; &#1575;&#1604;&#1581;&#1580;&#1605;Ø&#1404; &#1575;&#1604;&#1578;&#1608;&#1575;&#1601;&#1602; &#1608;&#1575;&#1604;&#1578;&#1606;&#1587;&#1610;&#1602; &#1575;&#1604;&#1571;&#1589;&#1604;&#1610; &#1605;&#1581;&#1601;&#1608;&#1592;&#1577; 100% &#1605;&#1606; &#1575;&#1604;&#1602;&#1575;&#1604;&#1576;"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Border Grid.Row="2" Background="{StaticResource CardWhiteBrush}" Padding="24,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Height="44"
                            Command="{Binding GenerateDocumentCommand}" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedTemplate}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#1573;&#1606;&#1588;&#1575;&#1569; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                <Setter Property="Text" Value="&#1580;&#1575;&#1585;&#1610; &#1575;&#1604;&#1573;&#1606;&#1588;&#1575;&#1569;..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                                         VerticalAlignment="Bottom" Margin="12,0"
                                         Foreground="White" Background="#55FFFFFF"/>
                        </Grid>
                    </Button>

                    <Button Grid.Column="1" Height="44"
                            Command="{Binding OpenDocumentCommand}" Margin="3,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastGenerated}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" Margin="0,0,6,0" Text="&#128194;"/>
                            <TextBlock Text="&#1601;&#1578;&#1581; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Height="44"
                            Command="{Binding PrintDocumentCommand}" Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastGenerated}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" Margin="0,0,6,0" Text="&#128424;"/>
                            <TextBlock Text="&#1591;&#1576;&#1575;&#1593;&#1577;"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- XXXX RIGHT PANEL XXXX -->
        <Border Grid.Column="1" Background="{StaticResource CardWhiteBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="20,24,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource PrimaryButton}" Height="40"
                        Command="{Binding SelectTemplatesFolderCommand}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" Margin="0,0,8,0" Text="&#128194;"/>
                        <TextBlock Text="&#1575;&#1582;&#1578;&#1585; &#1605;&#1580;&#1604;&#1583; &#1575;&#1604;&#1606;&#1605;&#1575;&#1584;&#1580;"/>
                    </StackPanel>
                </Button>

                <!-- Search -->
                <Border Grid.Row="1" Background="#FFF8F9FA" CornerRadius="4"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,16" Height="40">
                    <DockPanel Margin="10,0">
                        <TextBlock DockPanel.Dock="Right" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Text="&#128269;"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="4,0" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </Border>

                <TextBlock Grid.Row="2" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"
                           Text="&#1575;&#1582;&#1578;&#1585; &#1575;&#1604;&#1602;&#1575;&#1604;&#1576;"/>

                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Height="180" Margin="0,0,0,16">
                    <Grid>
                        <ListBox ItemsSource="{Binding FilteredTemplates}"
                                 SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsLoadingTemplates, Converter={StaticResource InvBoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:TemplateFile">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ProgressBar IsIndeterminate="True" Height="4"
                                     Visibility="{Binding IsLoadingTemplates, Converter={StaticResource BoolToVis}}"
                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="150"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="4" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"
                           Text="&#1575;&#1604;&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1605;&#1591;&#1604;&#1608;&#1576;&#1577;"/>

                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FormFields}"
                                      Visibility="{Binding HasFormFields, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PlaceholderField">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Key}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Arial" FontSize="14" Padding="10" MinHeight="36"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasFormFields, Converter={StaticResource InvBoolToVis}}"
                                   Text="&#1575;&#1582;&#1578;&#1585; &#1602;&#1575;&#1604;&#1576;&#1575;&#1611; &#1605;&#1606; &#1575;&#1604;&#1571;&#1593;&#1604;&#1609; &#1604;&#1593;&#1585;&#1590; &#1575;&#1604;&#1581;&#1602;&#1608;&#1604;"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="6" Orientation="Horizontal"
                            Visibility="{Binding HasFormFields, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource DangerButton}" Command="{Binding ClearFormCommand}"
                            Margin="0,0,8,0" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Margin="0,0,6,0" Text="&#128465;"/>
                            <TextBlock Text="&#1605;&#1587;&#1581; &#1575;&#1604;&#1581;&#1602;&#1608;&#1604;"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding ResetSelectionCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Margin="0,0,6,0" Text="&#10005;"/>
                            <TextBlock Text="&#1573;&#1604;&#1594;&#1575;&#1569; &#1575;&#1604;&#1578;&#1581;&#1583;&#1610;&#1583;"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="7" Background="{StaticResource ErrorBgBrush}"
                        BorderBrush="{StaticResource ErrorTextBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorTextBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
