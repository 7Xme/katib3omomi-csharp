<Window x:Class="Katib3omomy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Katib3omomy.ViewModels"
        xmlns:conv="clr-namespace:Katib3omomy.Core.Converters"
        xmlns:models="clr-namespace:Katib3omomy.Core.Models"
        mc:Ignorable="d"
        Title="&#1603;&#1575;&#1578;&#1576; &#1593;&#1605;&#1608;&#1605;&#1610; &#8212; &#1605;&#1608;&#1604;&#1583; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;&#1575;&#1578; &#1575;&#1604;&#1585;&#1587;&#1605;&#1610;&#1577;"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:InverseNullToVisibilityConverter x:Key="InvNullToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- XXXX LEFT PANEL XXXX -->
        <Grid Grid.Column="0" Background="#FFF5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="24,24,24,12"
                       Text="&#1605;&#1593;&#1575;&#1610;&#1606;&#1577; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;"/>

            <!-- Status Card -->
            <Border Grid.Row="1" Background="{StaticResource CardWhiteBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Margin="24,0,24,24" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <!-- Loading -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsParsingTemplate, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="200" Margin="0,0,0,12"/>
                        <TextBlock FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding ProgressDescription}"/>
                    </StackPanel>

                    <!-- Success -->
                    <StackPanel VerticalAlignment="Top"
                                Visibility="{Binding LastGenerated, Converter={StaticResource NullToVis}}">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                    Background="{StaticResource SuccessBgBrush}" Margin="0,0,12,0">
                                <TextBlock FontSize="24" Foreground="{StaticResource SuccessTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="&#10003;"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessTextBrush}"
                                           Text="&#1578;&#1605; &#1573;&#1606;&#1588;&#1575;&#1569; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583; &#1576;&#1606;&#1580;&#1575;&#1581;"/>
                                <TextBlock Text="{Binding LastGenerated.TemplateName}" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#FFF8F9FA" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,4"
                                           Text="&#1575;&#1587;&#1605; &#1575;&#1604;&#1605;&#1604;&#1601;:"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastGenerated.FileName}" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,4"
                                           Text="&#1578;&#1575;&#1585;&#1610;&#1582; &#1575;&#1604;&#1573;&#1606;&#1588;&#1575;&#1569;:"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastGenerated.GeneratedAt, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,0"
                                           Text="&#1575;&#1604;&#1605;&#1587;&#1575;&#1585;:"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastGenerated.FilePath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <TextBlock FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="&#1604;&#1571;&#1601;&#1590;&#1604; &#1580;&#1608;&#1583;&#1577; &#1591;&#1576;&#1575;&#1593;&#1577;&#1548; &#1575;&#1601;&#1578;&#1581; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583; &#1601;&#1610; Microsoft Word &#1579;&#1605; &#1575;&#1591;&#1576;&#1593;&#1607;."/>
                    </StackPanel>

                    <!-- Empty -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding CanShowEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#FFC0C0C0"
                                   Text="&#128196;"/>
                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"
                                   Text="&#1604;&#1605; &#1610;&#1578;&#1605; &#1573;&#1606;&#1588;&#1575;&#1569; &#1571;&#1610; &#1605;&#1587;&#1578;&#1606;&#1583; &#1576;&#1593;&#1583;"/>
                        <TextBlock FontSize="13" Foreground="#FFB0B0B0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Text="&#1575;&#1582;&#1578;&#1585; &#1602;&#1575;&#1604;&#1576;&#1575;&#1611; &#1605;&#1606; &#1575;&#1604;&#1610;&#1587;&#1575;&#1585; &#1608;&#1575;&#1605;&#1604;&#1571; &#1575;&#1604;&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1579;&#1605; &#1575;&#1590;&#1594;&#1591; &#1573;&#1606;&#1588;&#1575;&#1569; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;"/>
                    </StackPanel>

                    <!-- Preview -->
                    <Grid Visibility="{Binding CanShowPreview, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                <Run Text="&#1606;&#1589; &#1575;&#1604;&#1602;&#1575;&#1604;&#1576; (&#1602;&#1575;&#1576;&#1604; &#1604;&#1604;&#1578;&#1593;&#1583;&#1610;&#1604; &#1575;&#1604;&#1605;&#1572;&#1602;&#1578;): "/>
                                <Run Text="{Binding SelectedTemplate.Name}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Button Grid.Column="1" x:Name="UndoButton"
                                    Click="UndoButton_Click"
                                    Padding="8,4" MinWidth="0" Margin="0,0,4,0"
                                    ToolTip="&#1578;&#1585;&#1575;&#1580;&#1593; (Ctrl+Z)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/>
                                </Button.Style>
                                <TextBlock FontSize="16" Text="&#8617;"/>
                            </Button>
                            <Button Grid.Column="2" x:Name="RedoButton"
                                    Click="RedoButton_Click"
                                    Padding="8,4" MinWidth="0" Margin="0,0,8,0"
                                    ToolTip="&#1573;&#1593;&#1575;&#1583;&#1577; (Ctrl+Y)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/>
                                </Button.Style>
                                <TextBlock FontSize="16" Text="&#8618;"/>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ResetDraftCommand}"
                                    IsEnabled="{Binding IsDraftModified}"
                                    Margin="0,0,8,0" Padding="8,4" MinWidth="0"
                                    ToolTip="&#1573;&#1593;&#1575;&#1583;&#1577; &#1575;&#1604;&#1606;&#1589; &#1575;&#1604;&#1571;&#1589;&#1604;&#1610;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/>
                                </Button.Style>
                                <TextBlock FontSize="16" FontWeight="Bold" Text="&#8635;"/>
                            </Button>
                            <Button Grid.Column="4"
                                    Command="{Binding CopyPreviewCommand}"
                                    Padding="8,4" MinWidth="0"
                                    ToolTip="&#1606;&#1587;&#1582; &#1575;&#1604;&#1606;&#1589;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/>
                                </Button.Style>
                                <TextBlock FontSize="16" Text="&#128203;"/>
                            </Button>
                            <Button Grid.Column="5"
                                    Command="{Binding ToggleEditorCommand}"
                                    Padding="8,4" MinWidth="0" Margin="4,0,0,0"
                                    ToolTip="&#1578;&#1581;&#1585;&#1610;&#1585; &#1575;&#1604;&#1602;&#1575;&#1604;&#1576;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/>
                                </Button.Style>
                                <TextBlock FontSize="16" Text="&#9998;"/>
                            </Button>
                        </Grid>

                        <TextBox Grid.Row="1" x:Name="DraftTextBox"
                                 Text="{Binding DraftPreviewText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#FFF8F9FA" BorderBrush="{StaticResource BorderBrush}"
                                 FontFamily="Arial" FontSize="14.5" TextAlignment="Right"
                                 FlowDirection="RightToLeft"
                                 Padding="12" MinHeight="200"/>

                        <TextBlock Grid.Row="2"
                                   FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="&#1605;&#1593;&#1575;&#1610;&#1606;&#1577; &#1601;&#1602;&#1591; &#8226; &#1575;&#1604;&#1578;&#1593;&#1583;&#1610;&#1604;&#1575;&#1578; &#1607;&#1606;&#1575; &#1604;&#1575; &#1578;&#1572;&#1579;&#1585; &#1593;&#1604;&#1609; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583; &#8226; &#1575;&#1604;&#1582;&#1591;Ø&#1404; &#1575;&#1604;&#1581;&#1580;&#1605;Ø&#1404; &#1575;&#1604;&#1578;&#1608;&#1575;&#1601;&#1602; &#1608;&#1575;&#1604;&#1578;&#1606;&#1587;&#1610;&#1602; &#1575;&#1604;&#1571;&#1589;&#1604;&#1610; &#1605;&#1581;&#1601;&#1608;&#1592;&#1577; 100% &#1605;&#1606; &#1575;&#1604;&#1602;&#1575;&#1604;&#1576;"/>
                    </Grid>

                    <!-- Editor -->
                    <Grid Visibility="{Binding IsEditingTemplate, Converter={StaticResource BoolToVis}}"
                          IsVisibleChanged="EditorGrid_IsVisibleChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFF0F0F0" CornerRadius="4" Padding="4" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BoldBtn" Width="30" Height="28" Click="EditorBold_Click"
                                        ToolTip="&#1593;&#1585;&#1610;&#1590; (Ctrl+B)" FontWeight="Bold">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/></Button.Style>
                                    <TextBlock Text="B" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="ItalicBtn" Width="30" Height="28" Click="EditorItalic_Click" Margin="2,0"
                                        ToolTip="&#1605;&#1575;&#1574;&#1604; (Ctrl+I)" FontStyle="Italic">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/></Button.Style>
                                    <TextBlock Text="I" FontStyle="Italic" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="UnderlineBtn" Width="30" Height="28" Click="EditorUnderline_Click" Margin="0,0,8,0"
                                        ToolTip="&#1578;&#1587;&#1591;&#1610;&#1585; (Ctrl+U)">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/></Button.Style>
                                    <TextBlock Text="U" TextDecorations="Underline" HorizontalAlignment="Center"/>
                                </Button>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="FontSizeCombo" Width="60" Height="26" SelectedIndex="2"
                                          SelectionChanged="FontSizeCombo_SelectionChanged"
                                          FontSize="12" IsEditable="False">
                                    <ComboBoxItem Content="12"/>
                                    <ComboBoxItem Content="14"/>
                                    <ComboBoxItem Content="16"/>
                                    <ComboBoxItem Content="18"/>
                                    <ComboBoxItem Content="20"/>
                                    <ComboBoxItem Content="24"/>
                                    <ComboBoxItem Content="28"/>
                                    <ComboBoxItem Content="36"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#FFF8F9FA" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Click="InsertPlaceholder_Click" Padding="8,4" MinWidth="0" FontSize="12"
                                        ToolTip="&#1573;&#1583;&#1585;&#1575;&#1580; &#1581;&#1602;&#1604; &#1580;&#1583;&#1610;&#1583;">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/></Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBlock Text="&#1573;&#1583;&#1585;&#1575;&#1580; &#1581;&#1602;&#1604;"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="InsertPlaceholderBtn" Padding="8,4" MinWidth="0" FontSize="12" Margin="4,0"
                                        ToolTip="&#1573;&#1583;&#1585;&#1575;&#1580; *placeholder*">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/></Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="*Nm*" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBlock Text="Placeholder"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <RichTextBox Grid.Row="2" x:Name="EditorRichTextBox"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Arial" FontSize="16"
                                     Background="#FFF8F9FA" BorderBrush="{StaticResource BorderBrush}"
                                     Padding="12" MinHeight="200" FlowDirection="RightToLeft"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button Click="EditorSave_Click" Height="36" Width="100" Margin="0,0,8,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/></Button.Style>
                                <TextBlock Text="&#1581;&#1601;&#1592; &#1575;&#1604;&#1578;&#1593;&#1583;&#1610;&#1604;&#1575;&#1578;"/>
                            </Button>
                            <Button Command="{Binding ToggleEditorCommand}" Height="36" Width="100">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}"/></Button.Style>
                                <TextBlock Text="&#1573;&#1604;&#1594;&#1575;&#1569;"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Border Grid.Row="2" Background="{StaticResource CardWhiteBrush}" Padding="24,16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Height="44"
                            Command="{Binding GenerateDocumentCommand}" Margin="0,0,6,0"
                            IsEnabled="{Binding CanGenerate}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
                        </Button.Style>
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#1573;&#1606;&#1588;&#1575;&#1569; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                <Setter Property="Text" Value="&#1580;&#1575;&#1585;&#1610; &#1575;&#1604;&#1573;&#1606;&#1588;&#1575;&#1569;..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                                         VerticalAlignment="Bottom" Margin="12,0"
                                         Foreground="White" Background="#55FFFFFF"/>
                        </Grid>
                    </Button>

                    <Button Grid.Column="1" Height="44"
                            Command="{Binding OpenDocumentCommand}" Margin="3,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastGenerated}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" Margin="0,0,6,0" Text="&#128194;"/>
                            <TextBlock Text="&#1601;&#1578;&#1581; &#1575;&#1604;&#1605;&#1587;&#1578;&#1606;&#1583;"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Height="44"
                            Command="{Binding PrintDocumentCommand}" Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastGenerated}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" Margin="0,0,6,0" Text="&#128424;"/>
                            <TextBlock Text="&#1591;&#1576;&#1575;&#1593;&#1577;"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- XXXX RIGHT PANEL XXXX -->
        <Border Grid.Column="1" Background="{StaticResource CardWhiteBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="20,24,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Path bar -->
                <Border Grid.Row="0" Background="#FFF8F9FA" CornerRadius="4"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Height="36" Margin="0,0,0,8">
                    <DockPanel Margin="0,0,4,0">
                        <Button DockPanel.Dock="Left" Width="32" Height="32"
                                Command="{Binding GoUpCommand}"
                                IsEnabled="{Binding CanGoUp}"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="&#1575;&#1604;&#1605;&#1587;&#1578;&#1608;&#1610; &#1575;&#1604;&#1571;&#1593;&#1604;&#1609;">
                            <TextBlock FontSize="16" Text="&#11013;" Margin="0,0,4,0"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Width="32" Height="32"
                                Command="{Binding SelectTemplatesFolderCommand}"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="&#1575;&#1587;&#1578;&#1593;&#1585;&#1575;&#1590;">
                            <TextBlock FontSize="14" Text="&#128269;"/>
                        </Button>
                        <TextBlock Text="{Binding CurrentFolderPath, TargetNullValue='&#1575;&#1582;&#1578;&#1585; &#1605;&#1580;&#1604;&#1583;&#1575;&#1611;'}"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="PathEllipsis" Margin="4,0,4,0"/>
                    </DockPanel>
                </Border>

                <!-- File browser list -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                    <Grid>
                        <ListBox x:Name="FileBrowserListBox"
                                 ItemsSource="{Binding FileBrowserItems}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="FileBrowserListBox_MouseDoubleClick"
                                 Visibility="{Binding IsLoadingTemplates, Converter={StaticResource InvBoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:FileSystemEntry">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding FullPath}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ProgressBar IsIndeterminate="True" Height="4"
                                     Visibility="{Binding IsLoadingTemplates, Converter={StaticResource BoolToVis}}"
                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="150"/>
                    </Grid>
                </Border>

                <!-- Recent Folders -->
                <StackPanel Grid.Row="2" Margin="0,0,0,8"
                            Visibility="{Binding HasRecentFolders, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding RecentFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="x:String">
                                <Button Command="{Binding DataContext.SelectRecentFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource OutlinedButton}" Height="28"
                                        HorizontalContentAlignment="Right" Padding="6,0"
                                        Margin="0,0,0,2" FontSize="11">
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Grid.Row="3" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"
                           Text="&#1575;&#1604;&#1576;&#1610;&#1575;&#1606;&#1575;&#1578; &#1575;&#1604;&#1605;&#1591;&#1604;&#1608;&#1576;&#1577;"/>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FormFields}"
                                      Visibility="{Binding HasFormFields, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:PlaceholderField">
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource FieldLabel}"/>
                                            <Border BorderThickness="1" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                                <Setter Property="Background" Value="#1EFF0000"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="Arial" FontSize="14" Padding="10" MinHeight="36"
                                                         BorderThickness="0" Background="Transparent"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasFormFields, Converter={StaticResource InvBoolToVis}}"
                                   Text="&#1575;&#1582;&#1578;&#1585; &#1602;&#1575;&#1604;&#1576;&#1575;&#1611; &#1605;&#1606; &#1575;&#1604;&#1601;&#1575;&#1578;&#1581; &#1571;&#1593;&#1604;&#1575;&#1607;"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="5" Orientation="Horizontal"
                            Visibility="{Binding HasFormFields, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource DangerButton}" Command="{Binding ClearFormCommand}"
                            Margin="0,0,8,0" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Margin="0,0,6,0" Text="&#128465;"/>
                            <TextBlock Text="&#1605;&#1587;&#1581; &#1575;&#1604;&#1581;&#1602;&#1608;&#1604;"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding ResetSelectionCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Margin="0,0,6,0" Text="&#10005;"/>
                            <TextBlock Text="&#1573;&#1604;&#1594;&#1575;&#1569; &#1575;&#1604;&#1578;&#1581;&#1583;&#1610;&#1583;"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="6" Background="{StaticResource ErrorBgBrush}"
                        BorderBrush="{StaticResource ErrorTextBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorTextBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
